{
  "name": "@eco/mcp-server",
  "version": "1.1.0",
  "description": "MCP server stdio para crear, consultar y controlar bubbles de Eco desde Claude Code",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "eco-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2"
  }
}
